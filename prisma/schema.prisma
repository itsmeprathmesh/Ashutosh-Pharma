generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ProductStatus {
  active
  review
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  slug     String    @unique
  sortOrder Int      @default(0)
  products Product[]
}

model Product {
  id               Int      @id @default(autoincrement())
  name             String
  slug             String   @unique
  generic          String?
  strength         String?
  packSize         String?
  description      String
  imageUrl         String?
  rx               Boolean  @default(true)
  patentRestricted Boolean  @default(false)
  published        Boolean  @default(true)
  status           ProductStatus @default(active)
  statusNote       String?
  priceInr         Decimal? @db.Decimal(12, 2)
  priceUnit        String?
  images           Json     @default("[]")
  sourceRow        Int?
  categoryId       Int
  category         Category @relation(fields: [categoryId], references: [id])
  createdAt        DateTime @default(now())
  enquiries        Enquiry[]
  audits           ProductAudit[]

  @@index([published, status, name])
  @@index([published, status, createdAt])
  @@index([categoryId, published, status, name])
  @@index([categoryId, published, status, createdAt])
}

model Enquiry {
  id        Int      @id @default(autoincrement())
  name      String
  company   String?
  email     String
  phone     String?
  country   String
  product   String
  productId Int?
  productRecord Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  quantity  String
  licenceNo String?
  message   String?
  status    String   @default("new")
  ip        String?
  createdAt DateTime @default(now())

  items EnquiryItem[]

  @@index([ip, createdAt])
  @@index([createdAt])
  @@index([status, createdAt])
}

model ProductAudit {
  id        Int      @id @default(autoincrement())
  productId Int
  action    String
  actor     String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
}

model EnquiryItem {
  id        Int      @id @default(autoincrement())
  enquiryId Int
  product   String
  quantity  String
  enquiry   Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
}

model Subscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  createdAt DateTime @default(now())
}

model AdminLoginAttempt {
  id        Int      @id @default(autoincrement())
  ipHash    String
  createdAt DateTime @default(now())

  @@index([ipHash, createdAt])
  @@index([createdAt])
}

model BlogPost {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  title     String
  category  String
  excerpt   String
  content   String
  imageUrl  String?
  published Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([published, createdAt])
}
