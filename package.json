{
  "name": "ashutosh-pharma",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "admin:secrets": "node scripts/make-admin-secrets.mjs",
    "test:load": "k6 run tests/load/public.js",
    "test:load:smoke": "node scripts/load-smoke.mjs",
    "check": "npm run lint && npm run typecheck && npm run build && npm run test:unit && npm run test:e2e",
    "db:migrate:test": "node scripts/test-db-guard.mjs prisma migrate deploy",
    "db:seed:test": "node scripts/test-db-guard.mjs tsx prisma/seed.ts",
    "db:validate": "prisma validate",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@vercel/blob": "2.4.0",
    "@vercel/speed-insights": "^2.0.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "18.0.9",
    "embla-carousel-react": "^8.6.0",
    "exceljs": "^4.4.0",
    "framer-motion": "^14.9.0",
    "jose": "^6.2.14",
    "lucide-react": "^1.66.0",
    "next": "^16.4.3",
    "papaparse": "^5.7.0",
    "pg": "8.23.1",
    "prisma": "7.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "^6.37.0",
    "slugify": "^1.6.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.6.6",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "10.14.0",
    "eslint-config-next": "^16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1",
      "archiver": {
        "readdir-glob": {
          "minimatch": "^11.0.1"
        },
        "archiver-utils": {
          "glob": {
            "minimatch": "^11.0.1"
          }
        }
      }
    },
    "minimatch": "^11.0.1"
  },
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.1": true
  }
}
