{
  "name": "ashutosh-pharma",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:load": "k6 run tests/load/public.js",
    "test:load:smoke": "node scripts/load-smoke.mjs",
    "check": "npm run lint && npm run typecheck && npm run build && npm run test:unit && npm run test:e2e",
    "db:migrate:test": "node scripts/test-db-guard.mjs prisma migrate deploy",
    "db:seed:test": "node scripts/test-db-guard.mjs tsx prisma/seed.ts",
    "db:validate": "prisma validate",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-dialog": "^1.3.1",
    "@vercel/blob": "^2.8.2",
    "embla-carousel-react": "^8.6.0",
    "exceljs": "^4.4.0",
    "framer-motion": "^14.4.0",
    "lucide-react": "^1.59.0",
    "next": "15.5.28",
    "papaparse": "^5.7.0",
    "prisma": "^6.19.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "resend": "^6.34.1",
    "slugify": "^1.6.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
