# Database: use Neon pooled URL for DATABASE_URL and direct URL for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require&connect_timeout=5&pool_timeout=5"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DATABASE?sslmode=require&connect_timeout=5"

# Public site URL; no trailing slash.
NEXT_PUBLIC_SITE_URL="https://example.com"
SITE_URL="http://localhost:3100"

# Admin sign-in credentials and session signing secret. Set unique random values in deployment settings.
ADMIN_USER="replace-me"
ADMIN_PASS="replace-with-a-long-random-password"
ADMIN_SESSION_SECRET="replace-with-at-least-32-random-characters"

# Email integration. Leave unset if email notifications are disabled.
RESEND_API_KEY="re_..."
RESEND_FROM="Ashutosh Pharma <enquiries@example.com>"
OWNER_EMAIL="enquiries@example.com"

# Vercel Blob: public product images and private enquiry documents use separate tokens.
BLOB_READ_WRITE_TOKEN=""
BLOB_PRIVATE_READ_WRITE_TOKEN=""

# Optional Google Sheets sync webhook.
IMPORT_SECRET="replace-with-a-long-random-secret"
SHEET_URL=""

# Test-only guard. Keep disabled outside isolated browser-test configuration.
TEST_DATABASE_ENABLED="true"
